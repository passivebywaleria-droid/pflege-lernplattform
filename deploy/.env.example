# Pflege-Lernplattform — Produktions-Umgebung (Hetzner DE)
# KOPIE als deploy/.env anlegen und mit echten Werten fuellen. deploy/.env NIEMALS committen.

# ---- Domain (Caddy Auto-SSL) ----
DOMAIN=lernen.example.de

# ---- Postgres (lokaler Container, Daten auf DE-Maschine) ----
POSTGRES_USER=pflege
POSTGRES_PASSWORD=__CHANGE_ME_starkes_passwort__
POSTGRES_DB=pflege
# DATABASE_URL wird in docker-compose automatisch aus den obigen Werten gebaut
# (postgres://USER:PASSWORD@db:5432/DB) — hier nichts setzen.

# ---- Auth ----
# Generieren: openssl rand -base64 48
JWT_SECRET=__CHANGE_ME__

# ---- KI (Nebius, EU/Amsterdam, anonymisiert) ----
NEBIUS_API_KEY=

# ---- Sprache (Azure Speech: TTS/Whisper) — optional ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Web Push (VAPID). Generieren: npx web-push generate-vapid-keys ----
# PUBLIC ist Build-Arg (Client-Bundle), PRIVATE ist Server-Secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Stripe (Zahlungen) — optional, erst wenn Billing aktiv ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_SCHOOL_YEARLY=

# ---- Recherche/Tools — optional ----
EXA_API_KEY=

# ---- Vorschau-Modus (NUR Vorschau-Server!) ----
# "1" = Login + Einstufung werden uebersprungen, Inhalte direkt sichtbar.
# Im echten Pilot LEER lassen (= AUS), sonst ist die Plattform ungeschuetzt.
NEXT_PUBLIC_PREVIEW_OPEN=
